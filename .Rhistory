filter(AirlineName %in% comparison_airlines) %>%
group_by(AirlineName) %>%
summarise(
PriceValue = mean(PriceValue, na.rm = TRUE),
Comfort = mean(Comfort, na.rm = TRUE),
ServiceQuality = mean(ServiceQuality, na.rm = TRUE),
OnboardProduct = mean(OnboardProduct, na.rm = TRUE),
.groups = "drop"
) %>%
pivot_longer(
-AirlineName,
names_to = "Factor",
values_to = "AverageRating"
)
ggplot(
ComparisonData,
aes(
x = Factor,
y = AverageRating,
fill = AirlineName
)
) +
geom_col(
position = position_dodge(width = 0.75),
width = 0.65
) +
scale_fill_brewer(palette = "Set1") +
labs(
title = "Airline choice factors across business models",
subtitle = "Leisure travelers: low-cost vs full-service vs premium",
