TopAirlines <- data %>%
count(AirlineName, sort = TRUE) %>%
slice_head(n = 5) %>%
pull(AirlineName)
AirlineTime <- data %>%
filter(AirlineName %in% TopAirlines) %>%
group_by(AirlineName, Year) %>%
summarise(
PriceValue = mean(ValueRating, na.rm = TRUE),
Comfort = mean(SeatComfortRating, na.rm = TRUE),
.groups = "drop"
)
ggplot(AirlineTime,
aes(x = Year, y = PriceValue, color = AirlineName)) +
geom_line(linewidth = 1.2) +
labs(
title = "Evolution of price sensitivity by airline",
x = "",
y = "Average value-for-money rating"
) +
theme_minimal()
library(lubridate)
data <- data %>%
mutate(
DatePub = parse_date_time(
DatePub,
orders = c(
"ymd", "dmy", "mdy",
"Ymd HMS", "dmy HMS", "mdy HMS",
"B d Y", "d B Y"
)
),
Year = year(DatePub)
)
time_airlines <- c(
"Air France",
"Lufthansa",
"British Airways",
"KLM",
"Iberia",
"Ryanair",
"Aer Lingus",
"Emirates",
"Qatar Airways",
"Etihad Airways"
)
AirlineTime <- data %>%
filter(AirlineName %in% time_airlines, !is.na(Year)) %>%
group_by(AirlineName, Year) %>%
summarise(
PriceValue = mean(ValueRating, na.rm = TRUE),
Comfort = mean(SeatComfortRating, na.rm = TRUE),
.groups = "drop"
) %>%
filter(Year >= 1995)
AirlineTime <- AirlineTime %>%
mutate(
Region = case_when(
AirlineName %in% c("Ryanair", "Aer Lingus") ~ "European Low-Cost",
AirlineName %in% c(
"Air France", "Lufthansa",
"British Airways", "KLM", "Iberia"
) ~ "European Legacy",
AirlineName %in% c(
"Emirates", "Qatar Airways", "Etihad Airways"
) ~ "Gulf"
)
)
ggplot(
AirlineTime,
aes(
x = Year,
y = PriceValue,
color = Region,
linetype = AirlineName
)
) +
geom_line(linewidth = 1.2, alpha = 0.9) +
scale_color_brewer(palette = "Dark2") +
labs(
title = "Evolution of perceived value for money",
subtitle = "European and Gulf airlines – leisure travelers",
x = "",
y = "Average value-for-money rating",
color = "Airline group",
linetype = "Airline"
) +
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold", size = 18),
plot.subtitle = element_text(size = 13),
axis.text = element_text(size = 11),
legend.position = "right",
panel.grid.minor = element_blank()
)
ryanair_data <- data %>%
filter(AirlineName == "Ryanair")
RyanairFactors <- ryanair_data %>%
summarise(
PriceValue = mean(PriceValue, na.rm = TRUE),
Comfort = mean(Comfort, na.rm = TRUE),
ServiceQuality = mean(ServiceQuality, na.rm = TRUE),
