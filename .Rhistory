"Singapore Airlines",
"Japan Airlines",
"Korean Air",
"Asiana Airlines",
"Emirates",
"Qatar Airways"
)
selected_airlines <- c(
european_airlines,
american_airlines,
asian_airlines
)
asian_airlines <- c(
"Singapore Airlines",
"Japan Airlines",
"Korean Air",
"Asiana Airlines",
"Emirates",
"Qatar Airways"
)
selected_airlines <- c(
european_airlines,
american_airlines,
asian_airlines
)
data_selected <- data %>%
filter(AirlineName %in% selected_airlines)
AirlineFactors <- data_selected %>%
group_by(AirlineName) %>%
summarise(
PriceValue = mean(ValueRating, na.rm = TRUE),
Comfort = mean(SeatComfortRating, na.rm = TRUE),
Service = mean(ServiceRating, na.rm = TRUE),
Onboard = mean(
rowMeans(
select(cur_data(), FoodRating, EntertainmentRating, WifiRating),
na.rm = TRUE
),
na.rm = TRUE
),
.groups = "drop"
)
AirlineFactors_long <- AirlineFactors %>%
pivot_longer(
-AirlineName,
names_to = "Factor",
values_to = "AverageRating"
)
AirlineFactors_long <- AirlineFactors_long %>%
mutate(
Region = case_when(
AirlineName %in% european_airlines ~ "Europe",
AirlineName %in% american_airlines ~ "North America",
AirlineName %in% asian_airlines ~ "Asia"
)
)
ggplot(
filter(AirlineFactors_long, Factor == "PriceValue"),
aes(
x = reorder(AirlineName, AverageRating),
y = AverageRating,
fill = Region
)
) +
geom_col(width = 0.7) +
coord_flip() +
labs(
title = "Perceived value for money by airline",
subtitle = "Leisure travelers",
x = "",
y = "Average rating"
) +
scale_fill_brewer(palette = "Set2") +
theme_minimal(base_size = 15) +
theme(
plot.title = element_text(face = "bold", size = 18),
plot.subtitle = element_text(size = 13),
axis.text.y = element_text(size = 12),
legend.position = "top"
)
ggplot(
filter(AirlineFactors_long, Factor == "Comfort"),
aes(
x = reorder(AirlineName, AverageRating),
y = AverageRating,
fill = Region
)
) +
geom_col(width = 0.7) +
coord_flip() +
labs(
title = "Perceived comfort by airline",
subtitle = "Leisure travelers",
x = "",
y = "Average rating"
) +
scale_fill_brewer(palette = "Set2") +
theme_minimal(base_size = 15) +
theme(
plot.title = element_text(face = "bold", size = 18),
plot.subtitle = element_text(size = 13),
